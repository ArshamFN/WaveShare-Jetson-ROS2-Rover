[Unit]
Description=Rover Nav2 navigation stack
PartOf=rover-bringup.service
After=rover-bringup.service

[Service]
Type=simple
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && source %h/ros2_ws/install/setup.bash && exec ros2 launch nav2_bringup navigation_launch.py use_sim_time:=false params_file:=%h/ros2_ws/src/robot_description/config/nav2_params.yaml'
Environment=PYTHONUNBUFFERED=1
KillSignal=SIGINT
TimeoutStopSec=20
Restart=no
