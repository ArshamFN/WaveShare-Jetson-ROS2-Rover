[Unit]
Description=Rover pendant control node

[Service]
Type=simple
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash && source %h/ros2_ws/install/setup.bash && exec ros2 run pendant_bridge control_node'
Environment=PYTHONUNBUFFERED=1
KillSignal=SIGINT
TimeoutStopSec=20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
