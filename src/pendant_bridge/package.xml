<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pendant_bridge</name>
  <version>0.0.0</version>
  <description>Pendant control node that starts and stops the rover bringup and Nav2 systemd user services, reports their state, and saves maps.</description>
  <maintainer email="58406708+ArshamFN@users.noreply.github.com">Arsham Faghihnasiri</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>slam_toolbox</depend>
  <exec_depend>nav2_map_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
